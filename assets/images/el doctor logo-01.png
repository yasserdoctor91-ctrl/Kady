<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <style>
      .bg { fill: #ffffff; }
      .pink-primary { fill: #d96b9d; }
      .purple-dark { fill: #382d54; }
      .text-bold { font-family: 'Cairo', 'Tajawal', 'Segoe UI', sans-serif; font-weight: 900; fill: #382d54; }
      .text-sub { font-family: 'Cairo', 'Tajawal', 'Segoe UI', sans-serif; font-weight: 700; fill: #d96b9d; }
    </style>
    <linearGradient id="pinkGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e673a5" />
      <stop offset="100%" stop-color="#cc5a8d" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect class="bg" width="500" height="500" rx="40"/>

  <g transform="translate(0, 10)">
    <!-- Stethoscope Loops (Upper Left) -->
    <path class="purple-dark" d="M236,112 C230,85 195,85 185,115 C175,145 200,185 208,198 C192,208 170,182 155,160 C138,135 125,165 142,185 C162,210 195,215 208,198 C206,210 190,225 178,218 C170,213 166,224 172,228 C190,240 215,220 213,195 C225,175 242,130 236,112 Z" />
    
    <!-- Stethoscope Ear Piece / Diaphragm details -->
    <circle class="purple-dark" cx="178" cy="216" r="8" />
    <circle class="purple-dark" cx="228" cy="115" r="5" />
    <circle class="purple-dark" cx="196" cy="100" r="5" />

    <!-- Woman's Face & Hair Silhouette (Center Pink) -->
    <path fill="url(#pinkGrad)" d="M255,108 C255,108 262,150 252,192 C248,208 238,220 228,228 C215,238 202,230 192,212 C185,200 182,212 188,225 C200,250 230,258 255,245 C282,232 292,192 288,162 C286,145 278,125 255,108 Z" />

    <!-- Profile Nose & Lips Silhouette -->
    <path fill="url(#pinkGrad)" d="M254,108 C258,130 262,148 270,158 C273,162 278,165 273,172 C268,178 260,175 258,182 C255,190 262,198 256,208 C248,222 235,236 215,246 C202,252 190,248 185,238 C198,258 228,268 258,252 C285,238 296,202 292,168 C288,138 272,118 254,108 Z" />

    <!-- Decorative Leaves (Bottom Right) -->
    <!-- Leaf 1 (Purple) -->
    <path class="purple-dark" d="M302,235 C318,210 338,228 328,268 C318,280 298,262 302,235 Z" />
    <!-- Leaf 2 (Pink) -->
    <path class="pink-primary" d="M285,200 C305,180 320,215 312,255 C295,270 280,230 285,200 Z" />

    <!-- Main Title: الدكتور -->
    <text x="250" y="380" text-anchor="middle" class="text-bold" font-size="78">الدكتور</text>

    <!-- Subtitle: للمستلزمات الطبية و مستحضرات التجميل -->
    <text x="250" y="420" text-anchor="middle" class="text-sub" font-size="22" letter-spacing="0.5">للمستلزمات الطبية و مستحضرات التجميل</text>
  </g>
</svg>
